# ─────────────────────────────────────────────────────────────────────────────
# Rootsbay website — environment variables
#
# LOCAL (Windows / VS Code): in a PowerShell terminal run
#     Copy-Item .env.example .env.local
# then edit .env.local. That file is git-ignored — never commit it.
# PRODUCTION (Vercel): add the same names under
#     Project → Settings → Environment Variables.
#
# Lines marked PLACEHOLDER need a real value from Rootsbay. Leave a value empty to
# switch that feature off. With nothing filled in the site still runs, and
# enquiries submitted locally are saved to .data\enquiries.jsonl so you can test.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the site. Used for canonical links, the sitemap and structured data.
# PLACEHOLDER: confirm the final domain (this is the one Rootsbay owns).
NEXT_PUBLIC_SITE_URL=https://www.rootsbay.co

# ── Enquiry form delivery ────────────────────────────────────────────────────
# Option A (recommended): email through Resend — https://resend.com (free tier is enough).
#   1. Sign up and create an API key.
#   2. Paste it below.
#   3. Optional but recommended: verify the rootsbay.co domain in Resend (it shows DNS records
#      to add at the domain registrar), then use an address on that domain as the sender.

# PLACEHOLDER: API key from Resend, looks like re_xxxxxxxxxxxxxxxx
RESEND_API_KEY=

# PLACEHOLDER: inbox that should receive buyer enquiries. Comma-separate for several people.
ENQUIRY_TO_EMAIL=abhaygowda.work@gmail.com

# Sender shown on the enquiry email. onboarding@resend.dev works for testing (Resend only
# delivers it to the email you signed up with). After verifying the domain, use e.g.
#   "Rootsbay Website <enquiries@rootsbay.co>"
ENQUIRY_FROM_EMAIL="Rootsbay Website <onboarding@resend.dev>"

# true = also send the buyer a short "we received your enquiry" email.
ENQUIRY_AUTOREPLY=false

# Option B (can run alongside A): post every enquiry as JSON to a webhook, for example
# a Google Apps Script web app that appends rows to a Google Sheet, or a Zapier / Make hook.
# PLACEHOLDER: webhook URL, or leave empty.
ENQUIRY_WEBHOOK_URL=

# With neither option configured: `npm run dev` saves enquiries to .data\enquiries.jsonl;
# a production build shows "The form isn't connected yet" so no enquiry is silently lost.
