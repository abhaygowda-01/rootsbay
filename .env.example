# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.rootsbay.co

# ── Enquiry form delivery ────────────────────────────────────────────
# Option A (recommended): email via Resend — https://resend.com (free tier is enough)
# 1. Create an API key  2. Verify the rootsbay.co domain (adds DNS records)
RESEND_API_KEY=
# Who receives enquiries (comma-separate for several people)
ENQUIRY_TO_EMAIL=connect@rootsbay.co
# Must be on the verified domain once verified; before that, onboarding@resend.dev works for testing
ENQUIRY_FROM_EMAIL="Rootsbay Website <enquiries@rootsbay.co>"
# Send the buyer an automatic "we've received your enquiry" email
ENQUIRY_AUTOREPLY=false

# Option B (can run alongside A): POST every enquiry as JSON to a webhook —
# e.g. a Google Apps Script web app that appends rows to a Google Sheet,
# or a Zapier / Make / n8n hook that pushes to a CRM.
ENQUIRY_WEBHOOK_URL=

# With neither configured: in `npm run dev` enquiries are saved to .data/enquiries.jsonl;
# in production the form shows "isn't connected yet" so no enquiry is silently lost.
