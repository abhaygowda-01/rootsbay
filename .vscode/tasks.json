    {
      "label": "Type check",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Full check before publishing (lint + types + build)",
      "type": "npm",
      "script": "verify",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
